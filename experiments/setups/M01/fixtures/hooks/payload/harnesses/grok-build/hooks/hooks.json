{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -c \"import json;print(json.dumps({'decision':'deny','reason':'AI_STP_H01_DENY'}))\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -c \"import json;print(json.dumps({'decision':'allow','reason':'AI_STP_H02_ALLOW'}))\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
